ADMIN_PASSWORD_HASH=
WHATSAPP_CONFIG_KEY=
# Postgres connection string (required).
DATABASE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=reparosm_ordem_recebida
WHATSAPP_STATUS_TEMPLATE=reparosm_status_ordem
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=v25.0

# Endereço público do sistema, usado nos links dos e-mails de acesso
# (ex.: https://app.seudominio.com.br). Sem ele: URL, depois o domínio de produção da Vercel.
APP_URL=

# SMTP dos e-mails de acesso (convite, nova senha, confirmação de e-mail, aviso de
# senha alterada). Sem SMTP_HOST, os links aparecem para copiar e mandar pelo WhatsApp.
# Gmail: smtp.gmail.com, porta 465 ou 587, usuário = o e-mail, senha = senha de app.
# Brevo: smtp-relay.brevo.com, porta 587. Resend: smtp.resend.com, porta 465, usuário "resend".
SMTP_HOST=
SMTP_PORT=587
# true para TLS direto (porta 465); em branco, decide pela porta.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Remetente, ex.: ReparoSM <nao-responda@seudominio.com.br> (precisa ser um endereço que o SMTP aceita).
EMAIL_FROM=
# Opcional: para onde vão as respostas (ex.: o e-mail do suporte).
EMAIL_REPLY_TO=

# Chave da integração de pagamento que cria a loja depois da compra
# (POST /api/provisioning/stores). Em branco, a rota fica desligada. Use 32+ caracteres
# aleatórios, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVISIONING_TOKEN=
